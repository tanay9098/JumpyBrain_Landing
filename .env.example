# --- Email delivery (feedback form + questionnaire) ---
# SMTP credentials used to send notification emails via Nodemailer.
# Works with Gmail (use an App Password, not your normal password:
# https://myaccount.google.com/apppasswords), or any SMTP provider
# (Resend, Postmark, SendGrid, your company mail server, etc).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password-or-app-password

# Optional: the "From" address shown on outgoing mail. Defaults to SMTP_USER.
FEEDBACK_FROM_EMAIL=you@example.com

# Where feedback + questionnaire submissions are delivered.
FEEDBACK_TO_EMAIL=you@example.com
